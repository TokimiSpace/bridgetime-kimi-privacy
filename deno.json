{
  "name": "@tokimispace/bridgetime-kimi-privacy",
  "version": "0.1.0",
  "exports": "./src/mod.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14"
  },
  "tasks": {
    "fmt": "deno fmt --check",
    "check": "deno check src/mod.ts examples/synthetic_demo.ts tests/*.ts",
    "test": "deno test",
    "demo": "deno run examples/synthetic_demo.ts",
    "verify": "deno task fmt && deno task check && deno task test"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true
  }
}
